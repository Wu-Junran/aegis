# Aegis environment variables
#
# Copy to `.env` and fill in only the keys you need. Aegis does not source
# this file automatically — your shell or process manager does. The CLI
# reads them via `process.env.*`.

# ---- Provider credentials --------------------------------------------------
# Aegis prompts for credentials interactively and stores them in the OS
# keychain (`/provider creds <id>`). These env vars are the non-interactive
# fallback path used by tests and headless runs.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
MINIMAX_API_KEY=

# ---- Test / dogfood toggles ------------------------------------------------
# Force the test harness to require a working aegis-mcp before running. CI
# always sets this; local runs can leave it unset to skip MCP-dependent
# integration tests.
# AEGIS_REQUIRE_MCP=1
