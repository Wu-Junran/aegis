# Local upstream reference trees. The publishable release does not depend on
# these paths because the Claude Code-derived runtime source is included under
# aegis/src/.
claude-code-core/
claude-code/
# Upstream claude-code artifacts that leaked into project root.
.claude-plugin/
# Local Claude Code state + nested worktrees (~341 MB; per-machine, never
# version-controlled). Without this entry, `git add .` would stage a full
# source copy under `.claude/worktrees/...` plus per-machine settings.
.claude/
# Note: .github/ is now tracked (aegis-ci.yml added in M6 Task 6.30)

# OS / editor
.DS_Store
.vscode/
.devcontainer/

# Node
node_modules/
dist/
build/
*.log
# Exception: tsc baseline logs under docs/ are versioned artifacts
!docs/**/*.log

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# MCP config — per-machine, generated by aegis/scripts/generate-mcp-config.sh
/.mcp.json

# Internal development docs — not part of the published surface.
# Specs, plans, dogfood logs, and the publishing-prep checklist remain
# locally for ongoing work but are not shipped.
docs/superpowers/
docs/dogfood/
docs/publishing-checklist.md

# GIF-generation source scripts — local-only authoring tooling. The
# rendered .gif files under demos/gifs/ ship; the scripts that produce
# them do not.
demos/scripts/
