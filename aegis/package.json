    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.0",
    "@types/picomatch": "^3.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/semver": "^7.5.8",
    "@types/stack-utils": "^2.0.3",
    "@types/ws": "^8.5.0",
    "bun-types": "^1.3.13",
    "esbuild": "^0.25.0",
    "ink": "^7.0.1",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.1.0",
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
