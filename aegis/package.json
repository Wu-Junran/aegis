{
  "name": "aegis-cli",
  "version": "0.9.0",
  "description": "Aegis — clinical-documentation research harness (TypeScript CLI half)",
  "license": "Unlicense",
  "type": "module",
  "main": "src/entrypoints/cli.tsx",
  "bin": {
    "aegis": "src/entrypoints/cli.tsx"
  },
  "scripts": {
    "build": "bun scripts/build-bundle.ts",
    "build:watch": "bun scripts/build-bundle.ts --watch",
    "build:prod": "bun scripts/build-bundle.ts --minify",
    "build:web": "bun scripts/build-web.ts",
    "build:web:watch": "bun scripts/build-web.ts --watch",
    "build:web:prod": "bun scripts/build-web.ts --minify",
    "typecheck": "bash scripts/typecheck-baseline.sh",
    "typecheck:strict": "tsc --noEmit",
    "lint": "bash scripts/lint-baseline.sh",
    "lint:strict": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "check": "bun run lint && bun run typecheck",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:ci": "AEGIS_REQUIRE_MCP=1 bun test tests/unit tests/integration",
    "dogfood:synthea": "bun run scripts/dogfood/run-synthea.ts",
    "dogfood:synthea:record": "AEGIS_RECORD=1 bun run scripts/dogfood/run-synthea.ts --record"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@ant/claude-for-chrome-mcp": "file:./vendor-stubs/@ant/claude-for-chrome-mcp",
    "@ant/computer-use-mcp": "file:./vendor-stubs/@ant/computer-use-mcp",
    "@anthropic-ai/sandbox-runtime": "^0.0.49",
    "@anthropic-ai/sdk": "^0.39.0",
    "@commander-js/extra-typings": "^12.1.0",
    "@growthbook/growthbook": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.215.0",
    "@opentelemetry/core": "^2.7.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-logs": "^0.215.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@xterm/addon-fit": "^0.10.0",
